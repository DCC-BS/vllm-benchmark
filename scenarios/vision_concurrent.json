{
    "spec": {
        "profile": {
            "kind": "concurrent",
            "rampup_duration": 15,
            "streams": [10, 50, 100, 300],
            "warmup": { "percent": 0.1 },
            "cooldown": { "percent": 0.05 }
        },
        "data": [
            {
                "kind": "synthetic_text",
                "prompt_tokens": 128,
                "prompt_tokens_stdev": 32,
                "prompt_tokens_min": 1,
                "prompt_tokens_max": 512,
                "output_tokens": 256,
                "output_tokens_stdev": 64,
                "output_tokens_min": 1,
                "output_tokens_max": 1024
            },
            {
                "kind": "synthetic_image",
                "width": 896,
                "height": 896,
                "format": "jpeg",
                "jpeg_quality": 85,
                "content": "gradient",
                "images_per_request": 1
            }
        ],
        "constraints": [
            { "kind": "max_requests", "count": 500 },
            { "kind": "max_duration", "seconds": 600 },
            { "kind": "max_global_error_rate", "rate": 0.05, "minimum": 30, "stopping_scope": "all" }
        ]
    }
}
