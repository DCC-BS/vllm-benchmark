{
    "spec": {
        "profile": {
            "kind": "sweep",
            "max_concurrency": 128,
            "rampup_duration": 30,
            "sweep_size": 10,
            "warmup": { "percent": 0.1 },
            "cooldown": { "percent": 0.05 }
        },
        "data": [
            {
                "kind": "synthetic_text",
                "prompt_tokens": 512,
                "prompt_tokens_stdev": 128,
                "prompt_tokens_min": 1,
                "prompt_tokens_max": 1024,
                "output_tokens": 256,
                "output_tokens_stdev": 64,
                "output_tokens_min": 1,
                "output_tokens_max": 1024
            }
        ],
        "constraints": [
            { "kind": "max_requests", "count": 1000 },
            { "kind": "max_duration", "seconds": 600 },
            { "kind": "max_global_error_rate", "rate": 0.05, "minimum": 30, "stopping_scope": "all" },
            { "kind": "over_saturation", "mode": "monitor" }
        ]
    }
}
